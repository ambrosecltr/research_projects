{
  "format_version": 1,
  "manifest_format": "jsonl",
  "manifest_schema": "SourceDocument",
  "split": {
    "salt": "poetry50m-track1-8m-v2-ultrafineweb-gutenberg",
    "train": 0.9,
    "validation": 0.05,
    "test": 0.05
  },
  "tokenizer": {
    "vocab_size": 8192,
    "min_frequency": 2,
    "special_tokens": ["<|pad|>", "<|bos|>", "<|eos|>", "<|prompt|>", "<|thought|>", "<|poem|>", "<|mask|>"]
  },
  "packing": {
    "sequence_length": 1024
  },
  "objectives": {
    "conditional_poetry": 0.1,
    "auxiliary_prose_ntp": 0.4,
    "poetry_ntp": 0.5
  },
  "rights": {
    "allow_synthetic": true
  }
}
